{
  "name": "oddsdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "record-candles": "node --import tsx src/scripts/record-candles.ts",
    "record-binance-candles": "node --import tsx src/scripts/record-binance-candles.ts",
    "import-okx-funding": "node --import tsx src/scripts/import-okx-funding.ts",
    "download-okx-funding": "node --import tsx src/scripts/download-okx-funding.ts",
    "backtest": "node --import tsx src/scripts/backtest.ts",
    "walk-forward": "node --import tsx src/scripts/walk-forward.ts",
    "discover-signals": "node --import tsx src/scripts/discover-signals.ts",
    "discover-barrier-signals": "node --import tsx src/scripts/discover-barrier-signals.ts",
    "test-relative-pullback": "node --import tsx src/scripts/test-relative-pullback.ts",
    "pullback-geometry-tournament": "node --import tsx src/scripts/pullback-geometry-tournament.ts",
    "pullback-regime-tournament": "node --import tsx src/scripts/pullback-regime-tournament.ts",
    "entry-architecture-tournament": "node --import tsx src/scripts/entry-architecture-tournament.ts",
    "continuation-confidence-tournament": "node --import tsx src/scripts/continuation-confidence-tournament.ts",
    "continuation-robustness-audit": "node --import tsx src/scripts/continuation-robustness-audit.ts",
    "continuation-breadth-audit": "node --import tsx src/scripts/continuation-breadth-audit.ts",
    "continuation-direction-audit": "node --import tsx src/scripts/continuation-direction-audit.ts",
    "model-tournament": "node --import tsx src/scripts/model-tournament.ts",
    "capture-leaderboard": "node --import tsx src/scripts/capture-leaderboard.ts",
    "validate-registration": "node --import tsx src/scripts/validate-registration.ts",
    "watchdog": "node --import tsx src/scripts/watchdog.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "playwright": "^1.49.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
